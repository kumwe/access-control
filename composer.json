{
  "name": "kumwe/access-control",
  "description": "Portable authorization decisions, owner-bound policy registries, scopes and explicit authority ports.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/access-control",
  "support": {
    "issues": "https://github.com/kumwe/access-control/issues",
    "source": "https://github.com/kumwe/access-control"
  },
  "require": {
    "php": "^8.5",
    "kumwe/access-context": "0.1.0",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Access\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Access\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer:validate": "composer validate --strict",
    "lint": "php tools/lint.php",
    "lines": "php tools/check-lines.php",
    "docs": "php tools/check-docblocks.php",
    "architecture": "php tools/verify-architecture.php",
    "api": "php tools/verify-public-api.php",
    "api:record": "php tools/verify-public-api.php --write",
    "manifests": "php tools/verify-manifests.php",
    "autoload:smoke": "php resources/toolchain/autoload-smoke.php",
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "php tests/run.php",
    "check": [
      "@composer:validate",
      "@lint",
      "@lines",
      "@docs",
      "@architecture",
      "@api",
      "@manifests",
      "@autoload:smoke",
      "@cs",
      "@analyse",
      "@test",
      "@test:ownership",
      "@release-record",
      "@security",
      "@clean-consumer",
      "@release:integrity"
    ],
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "security": "composer audit --abandoned=fail",
    "release-record": "bash tools/test-release-record.sh",
    "examples": "@php examples/policies.php",
    "release:integrity": "bash tools/test-release-integrity.sh",
    "test:ownership": "php tools/verify-test-ownership.php --self-test"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
